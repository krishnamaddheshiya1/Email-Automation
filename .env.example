# ==============================================================================
# Email Automation Platform - Production Environment Configuration Template
# Phase 18: Production Deployment, Hardening & Final Client Readiness
#
# IMPORTANT:
# 1. Do NOT commit real secrets, API keys, passwords, or production tokens to git.
# 2. Copy this file to .env.local for local development or deploy to your production
#    environment (Vercel, AWS, Docker, Railway, Fly.io, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Server Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Canonical production base URL (e.g. https://email.yourdomain.com)
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
# Allowed CORS origins for API requests (comma-separated if multiple)
ALLOWED_ORIGINS=https://app.yourdomain.com

# ------------------------------------------------------------------------------
# 2. Database & Multi-Tenant Storage (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Production connection string with SSL enabled
DATABASE_URL=

# Supabase Auth & Storage API Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Security, Encryption & Session Management
# ------------------------------------------------------------------------------
# 32-byte hex or base64 key used to encrypt provider API keys and sensitive tokens at rest
# Generate with: openssl rand -hex 32
EMAIL_SECRET_ENCRYPTION_KEY=
PROVIDER_ENCRYPTION_KEY=
# Secret for HMAC signing of unsubscribe tokens and sensitive actions
APP_SECRET=

# ------------------------------------------------------------------------------
# 4. Email Delivery Provider (Resend & Inbound Reply Routing)
# ------------------------------------------------------------------------------
# Primary Resend API Key for dispatching outbound campaign emails
RESEND_API_KEY=
# Resend Webhook Signing Secret for authenticating delivery and inbound reply webhooks
# Configured in Resend Dashboard -> Webhooks -> Endpoint: https://app.yourdomain.com/api/webhooks/inbound
RESEND_WEBHOOK_SECRET=

# Default fallback sender identity (overridden by tenant-configured sender identities)
EMAIL_FROM_NAME="Your Company Team"
EMAIL_FROM_ADDRESS=outreach@yourdomain.com
EMAIL_REPLY_TO=replies@yourdomain.com

# ------------------------------------------------------------------------------
# 5. Safety, Rate Limiting & Deliverability Ceilings
# ------------------------------------------------------------------------------
# Outbound rate limit per minute to avoid provider throttle
EMAIL_SEND_RATE_PER_MINUTE=120
# Tenant default hourly limit (e.g. 500 emails/hour)
CAMPAIGN_HOURLY_SEND_LIMIT=500
# Tenant default daily limit (e.g. 5000 emails/day)
CAMPAIGN_DAILY_SEND_LIMIT=5000
# Development safety ceiling (set to 0 to disable in production)
CAMPAIGN_DEV_SEND_LIMIT=0

# ------------------------------------------------------------------------------
# 6. Campaign Worker & Queue Orchestration
# ------------------------------------------------------------------------------
# Interval in seconds between campaign execution ticks
CAMPAIGN_WORKER_INTERVAL_SECONDS=60
# Number of contacts processed per batch per campaign step
CAMPAIGN_WORKER_BATCH_SIZE=50
# Maximum retry attempts on transient delivery failures
CAMPAIGN_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 7. File Attachments & Object Storage Configuration
# ------------------------------------------------------------------------------
# Storage provider backend: 'local' (default) or 's3' or 'supabase'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage
# Maximum individual file size in bytes (default 10MB = 10485760)
MAX_ATTACHMENT_SIZE=10485760
# Maximum total attachments per email message in bytes (default 25MB = 26214400)
MAX_TOTAL_ATTACHMENT_SIZE=26214400

# ------------------------------------------------------------------------------
# 8. Contact Import & Audience Management
# ------------------------------------------------------------------------------
# Batch size for streaming CSV imports
CONTACT_IMPORT_BATCH_SIZE=250
# Maximum CSV file upload size in MB (default 15MB)
CONTACT_IMPORT_MAX_FILE_MB=15
